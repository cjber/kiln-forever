-- The addon runs inside the WoW client, which provides its own globals. This list
-- covers the API and the globals the addon sets, so luacheck reports real mistakes.
std = "lua51+luajit"
max_line_length = false
unused_args = false
shadowing = false

-- The tracker host spec's pinned Blizzard source, fetched by tools/fetch_tracker_ui.py.
exclude_files = {
	"addon/KilnForever/tools/.cache/*",
}

globals = {
	"AlertFrame",
	"BINDING_HEADER_KILNFOREVER",
	"BINDING_NAME_KILNFOREVER_NEW",
	"BINDING_NAME_KILNFOREVER_TOGGLE",
