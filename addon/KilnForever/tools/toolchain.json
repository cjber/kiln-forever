{
  "schema": 1,
  "runtimes": {
    "python": {
      "version": "3.14",
      "upstream": {
        "kind": "github-release",
        "repo": "python/cpython",
        "strip": "minor",
        "tag": "v{version}"
      }
    },
    "node": {
      "version": "26",
      "upstream": {
        "kind": "github-release",
        "repo": "nodejs/node",
        "strip": "major",
        "tag": "v{version}"
      }
    },
    "bun": {
      "version": "1.4.5",
      "upstream": {
        "kind": "npm",
        "package": "bun"
      }
    }
  },
  "tools": {
    "lua51": {
      "version": "5.1.5",
      "url": "https://www.lua.org/ftp/lua-{version}.tar.gz",
      "sha256": "2640fc56a795f29d28ef15e13c34a47e223960b0240e8cb0a82d9b0738695333",
      "note": "Stays on the 5.1 series: the game client runs Lua 5.1, so 5.2 and newer are not an update.",
      "upstream": {
        "kind": "github-tag",
        "repo": "lua/lua",
        "series": "^5\\.1\\.",
        "tag": "v{version}"
      }
    },
    "luajit": {
      "commit": "63c8f1a9b479ba5518cf6a170ff7729178bc3cfd",
      "upstream": {
        "kind": "github-branch",
        "repo": "LuaJIT/LuaJIT",
        "branch": "v2.1"
      }
    },
    "luacheck": {
      "version": "1.2.0",
      "commit": "cc089e3f65acdd1ef8716cc73a3eca24a6b845e4",
      "upstream": {
        "kind": "github-tag",
        "repo": "lunarmodules/luacheck",
        "tag": "v{version}"
      }
    },
    "argparse": {
      "version": "0.7.2",
      "commit": "a5ab54f8161f9f508b058411f64c2c72d974733b",
      "upstream": {
        "kind": "github-tag",
        "repo": "luarocks/argparse",
        "tag": "{version}"
      }
    },
    "luafilesystem": {
      "version": "1.9.0",
      "commit": "a186cca5833691e830ed255e38ace8ff6b870dbf",
      "upstream": {
        "kind": "github-tag",
        "repo": "lunarmodules/luafilesystem",
        "tag": "v{version}"
      }
    },
    "luals": {
      "version": "3.19.2",
      "url": "https://github.com/LuaLS/lua-language-server/releases/download/{version}/lua-language-server-{version}-linux-x64.tar.gz",
      "sha256": "93ad326b10f6c00911dd8c450fa098332dbd8f9f45d1052f5636a2d54479b947",
      "upstream": {
        "kind": "github-release",
        "repo": "LuaLS/lua-language-server",
        "tag": "{version}"
      }
    },
    "stylua": {
      "version": "2.6.0",
      "url": "https://github.com/JohnnyMorganz/StyLua/releases/download/v{version}/stylua-linux-x86_64.zip",
      "sha256": "a485f72bbfa22e4642e77a84b5edc2611a5cab7477b34e2e709dd8f78e919895",
      "upstream": {
        "kind": "github-release",
        "repo": "JohnnyMorganz/StyLua",
        "tag": "v{version}"
      }
    },
    "gitleaks": {
      "version": "8.30.1",
      "url": "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_linux_x64.tar.gz",
      "sha256": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb",
      "upstream": {
        "kind": "github-release",
        "repo": "gitleaks/gitleaks",
        "tag": "v{version}"
      }
    },
    "annotations": {
      "commit": "d0b5b51fac4c52c493371b9b18e66ce604ea4326",
      "upstream": {
        "kind": "github-branch",
        "repo": "Ketho/vscode-wow-api",
        "branch": "master"
      }
    },
    "speedpatrol": {
      "version": "0.4.1",
      "upstream": {
        "kind": "npm",
        "package": "speedpatrol"
      }
    }
  }
}
